{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./data"],
      "enabled": true
    },
    "web-fetch": {
      "type": "remote",
      "url": "https://example-mcp-fetch.dev",
      "enabled": true
    }
  }
}
